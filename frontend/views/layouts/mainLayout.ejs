<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Aureo</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/css/theme.css" />
  <script>
    try {
      if (sessionStorage.getItem("aureo-zoom")) {
        sessionStorage.removeItem("aureo-zoom");
        document.documentElement.classList.add("zoom-in");
      }
    } catch (e) {}
    const clearNames = () =>
      document.querySelectorAll("a[data-vt] img").forEach((img) => (img.style.viewTransitionName = ""));

    document.addEventListener("click", (e) => {
      const link = e.target.closest("a[data-vt]");
      const img = link && link.querySelector("img");
      if (!img) return;
      clearNames();
      img.style.viewTransitionName = "product-img";
    });
    window.addEventListener("pagereveal", (e) => {
      clearNames();
      const from = window.navigation?.activation?.from?.url;
      if (!e.viewTransition || !from) return;
      const img = document.querySelector(`a[data-vt][href="${new URL(from).pathname}"] img`);
      if (!img) return;
      img.style.viewTransitionName = "product-img";
      e.viewTransition.finished.finally(clearNames);
    });
  </script>
</head>
<body>
  <header class="site-header">
    <div class="inner">
      <a href="/" class="brand" aria-label="Aureo">
        <img class="brand-mark" src="/img/aureo-mark.svg" alt="" width="28" height="28" />
        <span class="brand-text">Aureo</span>
      </a>
      <nav class="main-nav" aria-label="Hauptnavigation">
        <% nav.forEach(function (item) { %>
          <a href="<%= item.path %>" class="<%= currentPath === item.path || (item.path !== '/' && currentPath.startsWith(item.path + '/')) ? 'active' : '' %>"><%= item.label %></a>
        <% }); %>
      </nav>
      <a href="/shoppingcart" class="cart-link <%= currentPath === '/shoppingcart' ? 'active' : '' %>" aria-label="Warenkorb" title="Warenkorb">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span>Warenkorb</span>
      </a>
    </div>
  </header>

  <main class="page <%= currentPath === '/' ? 'page-home' : '' %>">
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="inner">
      <span class="foot-brand"><img src="/img/aureo-mark.svg" alt="" width="26" height="26" />Aureo</span>
    </div>
  </footer>
</body>
</html>
