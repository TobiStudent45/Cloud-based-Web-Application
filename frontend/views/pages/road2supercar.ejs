<section class="card page-head">
  <h1>Road to the Super Car</h1>
  <p class="muted">Super Car auf einer Karte auf dem Weg zur Praesentation.</p>
</section>

<% if (apiError) { %>
  <div class="stub-note">Service nicht erreichbar: <%= apiError %></div>
<% } else if (data) { %>
  <pre class="stub-note"><%= JSON.stringify(data, null, 2) %></pre>
<% } else { %>
  <div class="stub-note">Noch keine Daten. Endpunkt in config/pages.js hinterlegen.</div>
<% } %>
