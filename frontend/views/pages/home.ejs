<link rel="stylesheet" href="/css/home.css" />

<div class="home">
  <section class="hero" aria-labelledby="home-title">
    <div class="hero-bg" aria-hidden="true">
      <span class="hero-grid"></span>
      <span class="hero-orb o1"></span>
      <span class="hero-orb o2"></span>
      <span class="hero-orb o3"></span>
      <span class="hero-road"></span>
      <span class="hero-streak s1"></span>
      <span class="hero-streak s2"></span>
      <span class="hero-streak s3"></span>
      <span class="hero-streak s4"></span>
      <span class="hero-fade"></span>
    </div>
    <div class="wrap">
      <h1 id="home-title" class="rv" style="--d:.08s">Das Auto,<br><span>das du dir vorstellst.</span></h1>
      <p class="sub rv" style="--d:.16s">Konfiguriere dein Fahrzeug in 3D, entdecke die Kollektion und erlebe Aureo.</p>
      <div class="hbtns rv" style="--d:.24s">
        <a class="hcta" href="/configurator">Konfigurator starten</a>
      </div>
    </div>
  </section>

  <div class="wrap stage-wrap">
    <div class="stage" id="home-stage">
      <figure class="s-l"><img src="<%= productPicturesUrl %>/sportscar-front-detail.jpg" alt="Frontpartie eines schwarzen Sportwagens" width="800" height="1422" /></figure>
      <figure class="s-c"><img src="<%= productPicturesUrl %>/sportscar-red-rear.jpg" alt="Roter Sportwagen mit Rundscheinwerfern" width="1200" height="675" /></figure>
      <figure class="s-r"><img src="<%= productPicturesUrl %>/sportscar-interior.jpg" alt="Cockpit mit Alcantara-Lenkrad" width="800" height="1200" /></figure>
      <span class="hbadge b1" aria-hidden="true" style="--bd:.05s;--fx:18;--fy:12;--rot:-4deg"><span class="bi"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16.008v-8.018a1.98 1.98 0 0 0-1-1.717l-7-4.008a2.016 2.016 0 0 0-2 0l-7 4.008c-.619.355-1 1.01-1 1.718v8.018c0 .709.381 1.363 1 1.717l7 4.008a2.016 2.016 0 0 0 2 0l7-4.008c.619-.355 1-1.01 1-1.718z"/><path d="M12 22v-10"/><path d="M12 12l8.73-5.04"/><path d="M3.27 6.96l8.73 5.04"/></svg></span>3D live konfigurierbar</span>
      <span class="hbadge b2" aria-hidden="true" style="--bd:.2s;--fx:-20;--fy:9;--rot:3deg"><span class="bi"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 3v7h6l-8 11v-7H5l8-11"/></svg></span>612 PS</span>
      <span class="hbadge b3" aria-hidden="true" style="--bd:.35s;--fx:19;--fy:-20;--rot:3deg"><span class="bi"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.2 7a6 6 0 1 0 0 10"/><path d="M13 10H5"/><path d="M13 14H5"/></svg></span>Live Preisübersicht</span>
      <span class="hbadge b4" aria-hidden="true" style="--bd:.5s;--fx:-21;--fy:-24;--rot:-3deg"><span class="bi"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 5h12l3 5-8.5 9.5a.7.7 0 0 1-1 0L3 10l3-5"/><path d="M10 12 8 9.8 8.6 9"/></svg></span>Carbon und Alcantara</span>
    </div>
  </div>

  <div class="wrap">
    <div class="stats rv" aria-label="Aureo in Zahlen">
      <div><b data-n="2011" data-from="1990" data-plain="1">2011</b><span>Gegründet</span></div>
      <div><b data-n="18400">18.400</b><span>Ausgelieferte Fahrzeuge</span></div>
      <div><b data-n="42">42</b><span>Märkte weltweit</span></div>
      <div><b data-n="1020">1.020</b><span>Mitarbeitende</span></div>
    </div>
  </div>

  <div class="marq rv" aria-label="Fotogalerie">
    <div class="track">
      <% const marq = [
        ['marquee-01', 'Oranger Sportwagen in Seitenansicht'],
        ['marquee-02', 'Blauer Sportwagen auf der Straße'],
        ['marquee-03', 'Weißes Coupé vor einer Ziegelwand'],
        ['marquee-04', 'Rad mit Bremssattel eines Sportwagens'],
        ['marquee-05', 'Sportwagen mit Rücklichtern bei Nacht'],
        ['marquee-06', 'Roter Sportwagen in der Stadt bei Nacht'],
        ['marquee-07', 'Heckpartie eines grauen Supersportwagens'],
        ['marquee-08', 'Roter Sportwagen von vorne']
      ]; %>
      <% marq.forEach(function (m) { %><img src="<%= productPicturesUrl %>/<%= m[0] %>.jpg" alt="<%= m[1] %>" width="300" height="200" loading="lazy" /><% }); %>
      <% marq.forEach(function (m) { %><img src="<%= productPicturesUrl %>/<%= m[0] %>.jpg" alt="" aria-hidden="true" width="300" height="200" loading="lazy" /><% }); %>
    </div>
  </div>

  <section class="sec" aria-labelledby="home-features">
    <div class="wrap">
      <h2 id="home-features" class="rv">Alles an einem Ort.</h2>
      <p class="lead rv" style="--d:.1s">Von der ersten Idee bis zum fertigen Fahrzeug. Ein durchgängiges Erlebnis.</p>

      <div class="bento">
        <a class="tile span2 beam rv" href="/configurator">
          <div class="cfg">
            <div>
              <h3>Konfigurator</h3>
              <p>Lack, Felgen und Innenraum live im 3D-Modell anpassen, inklusive Preisübersicht.</p>
              <span class="go">Jetzt öffnen <span aria-hidden="true">→</span></span>
            </div>
            <img src="<%= productPicturesUrl %>/tile-configurator.jpg" alt="Felge eines hellblauen Sportwagens" width="600" height="460" loading="lazy" />
          </div>
        </a>
        <a class="tile photo rv" href="/impressions" style="--d:.08s">
          <img src="<%= productPicturesUrl %>/tile-impressions.jpg" alt="Silberner Sportwagen in Seitenansicht" width="600" height="500" loading="lazy" />
          <span class="go-chip" aria-hidden="true">→</span>
          <div class="t"><h3>Impressionen</h3><p>Video und Galerie</p></div>
        </a>

        <a class="tile rv" href="/merchandise">
          <h3>Merchandise</h3>
          <p>Caps, Shirts und mehr.</p>
          <div class="mer" aria-hidden="true"><span>Cap</span><span>Shirt</span></div>
          <span class="go">Entdecken <span aria-hidden="true">→</span></span>
        </a>
        <a class="tile span2 rv" href="/road2supercar" style="--d:.08s">
          <h3>Road2Supercar</h3>
          <p>Der Weg vom Entwurf zum Supercar.</p>
          <div class="rd" aria-hidden="true">
            <span class="n">1</span><span class="l"></span><span class="n">2</span><span class="l"></span><span class="n">3</span><span class="l"></span><span class="n f">✓</span>
          </div>
          <span class="go">Entdecken <span aria-hidden="true">→</span></span>
        </a>
        <a class="tile rv" href="/ai" style="--d:.16s">
          <h3>AI Feature</h3>
          <p>Kreativ mit Gemini.</p>
          <div class="ai" aria-hidden="true"><em>Ein Supercar bei Sonnenuntergang</em><b>↑</b></div>
          <span class="go">Ausprobieren <span aria-hidden="true">→</span></span>
        </a>
        <a class="tile photo span2 rv" href="/impressions" style="--d:.08s">
          <img src="<%= productPicturesUrl %>/tile-v12.jpg" alt="V12-Motor mit Typenschild" width="1000" height="500" loading="lazy" />
          <span class="go-chip" aria-hidden="true">→</span>
          <div class="t"><h3>V12 Handarbeit</h3><p>Technik, die man sehen darf.</p></div>
        </a>
      </div>

    </div>
  </section>

  <section class="story" aria-labelledby="home-story">
    <div class="wrap">
      <h2 id="home-story" class="rv">Unsere Geschichte.</h2>
      <p class="lead rv" style="--d:.1s">Von der Werkhalle zur Marke, die man auf allen Kontinenten kennt.</p>
      <div class="tl-wrap" id="home-timeline">
        <span class="tl-track" aria-hidden="true"></span>
        <span class="tl-fill" aria-hidden="true"><i class="tl-head"></i></span>
      <ol class="tl">
        <li><span class="yr">2011</span><h3>Gründung</h3><p>Drei Ingenieure, eine Werkhalle und der Plan, Sportwagen neu zu denken.</p></li>
        <li><span class="yr">2014</span><h3>Erster Prototyp</h3><p>Der erste Aureo dreht seine Runden auf der Teststrecke.</p></li>
        <li><span class="yr">2017</span><h3>V12 Handarbeit</h3><p>Unser erster Zwölfzylinder entsteht komplett in Handarbeit.</p></li>
        <li><span class="yr">2021</span><h3>Digitaler Showroom</h3><p>Kunden gestalten ihr Fahrzeug erstmals online in 3D.</p></li>
        <li><span class="yr">2025</span><h3>Neue Modellreihe</h3><p>Zwei neue Modelle, konfigurierbar bis ins letzte Detail.</p></li>
      </ol>
      </div>
    </div>
  </section>
</div>

<script src="/js/home.js" defer></script>
