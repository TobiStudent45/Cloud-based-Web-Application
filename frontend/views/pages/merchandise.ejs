<%
  const isDetail = Boolean(locals.backPath);
  const formatPrice = (p) =>
    new Intl.NumberFormat("de-DE", { style: "currency", currency: "EUR" }).format(p);
%>
<% if (isDetail && locals.fromCart) { %>
  <a href="/shoppingcart" class="close-link" aria-label="Schließen" title="Schließen">✕</a>
<% } else if (isDetail) { %>
  <a href="<%= backPath %>" class="back-link">← Weitere Artikel</a>
<% } %>

<% if (apiError) { %>
  <div class="stub-note">Produkt<%= isDetail ? "" : "e" %> konnte<%= isDetail ? "" : "n" %> nicht geladen werden: <%= apiError %></div>

<% } else if (!isDetail) { %>
  <% if (!data || data.length === 0) { %>
    <div class="stub-note">Aktuell keine Produkte vorhanden.</div>
  <% } else { %>
    <div class="grid product-grid">
      <% data.forEach(function (p) { %>
        <a href="/merchandise/<%= p.id %>" class="card product-card" data-vt>
          <% if (p.image_url) { %>
            <img src="<%= p.image_url %>" alt="<%= p.name %>" />
          <% } %>
          <h2><%= p.name %></h2>
          <p class="price"><%= formatPrice(p.price) %></p>
        </a>
      <% }); %>
    </div>
  <% } %>

<% } else { %>
  <section class="card product-detail">
    <% if (data.image_url) { %>
      <img src="<%= data.image_url %>" alt="<%= data.name %>" style="view-transition-name: product-img" />
    <% } %>

    <div class="product-info">
      <p class="muted"><%= data.category %></p>
      <h1><%= data.name %></h1>
      <p class="price"><%= formatPrice(data.price) %></p>
      <p><%= data.short_description %></p>
      <p class="muted"><%= data.description %></p>

      <% if (data.color) { %>
        <dl class="product-facts">
          <dt>Farbe</dt><dd><%= data.color %></dd>
        </dl>
      <% } %>

      <form class="add-to-cart" onsubmit="return false">
        <input type="hidden" name="productId" value="<%= data.id %>" />
        <% if (data.sizes && data.sizes.length) { %>
          <label>Größe
            <select name="size" required>
              <% data.sizes.forEach(function (s) { %>
                <option value="<%= s %>" <%= locals.selectedSize === s ? "selected" : "" %>><%= s %></option>
              <% }); %>
            </select>
          </label>
        <% } %>
        <% const maxQty = Math.max(data.stock, 1); %>
        <label>Menge
          <select name="quantity" class="qty-select">
            <% for (let i = 1; i <= Math.min(10, maxQty); i++) { %>
              <option value="<%= i %>"><%= i %></option>
            <% } %>
            <% if (maxQty > 10) { %><option value="more">mehr …</option><% } %>
          </select>
          <input type="number" class="qty-input" min="1" max="<%= maxQty %>" value="11" hidden disabled />
        </label>
        <button type="submit" class="btn" <%= data.in_stock ? "" : "disabled" %>>
          <%= data.in_stock ? "In den Warenkorb" : "Ausverkauft" %>
        </button>
      </form>
      <% if (locals.fromCart) { %>
        <button type="button" class="btn btn-outline" id="remove-from-cart">Entfernen</button>
      <% } %>
      <script>
        const cartForm = document.querySelector("form.add-to-cart");
        cartForm.addEventListener("submit", async (e) => {
          e.preventDefault();
          const btn = cartForm.querySelector("button[type=submit]");
          const fd = new FormData(cartForm);
          try {
            const res = await fetch("/api/cart/items", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                type: "merch",
                productId: Number(fd.get("productId")),
                size: fd.get("size") || null,
                quantity: Number(fd.get("quantity")) || 1,
              }),
            });
            const cart = await res.json();
            if (!res.ok) throw new Error(cart.error);
            btn.textContent = "Hinzugefügt ✓";
            document.dispatchEvent(new CustomEvent("cart:changed", { detail: cart }));
          } catch (err) {
            btn.textContent = err.message || "Fehler";
          }
          setTimeout(() => (btn.textContent = "In den Warenkorb"), 1800);
        });
        const removeBtn = document.getElementById("remove-from-cart");
        if (removeBtn) {
          removeBtn.addEventListener("click", async () => {
            const size = new FormData(cartForm).get("size") || "-";
            const productId = cartForm.querySelector("[name=productId]").value;
            removeBtn.disabled = true;
            try {
              const res = await fetch("/api/cart/items/" + encodeURIComponent(`merch:${productId}:${size}`), { method: "DELETE" });
              if (!res.ok) throw new Error();
              document.dispatchEvent(new CustomEvent("cart:changed", { detail: await res.json() }));
              location.href = "/shoppingcart";
            } catch (err) {
              removeBtn.disabled = false;
              removeBtn.textContent = "Fehler, bitte erneut versuchen";
            }
          });
        }
        document.querySelector(".qty-select").addEventListener("change", (e) => {
          if (e.target.value !== "more") return;
          const input = e.target.nextElementSibling;
          e.target.hidden = e.target.disabled = true;
          input.hidden = input.disabled = false;
          input.name = "quantity";
          input.focus();
          input.select();
        });
      </script>
    </div>
  </section>
<% } %>
