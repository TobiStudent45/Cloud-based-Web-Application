# Local dependencies, env files, logs, compose overrides and editor files are ignored.
# Application code, package-lock.json, Dockerfiles, SQL files and the GLB models stay tracked.
node_modules/
.npm-cache/

.env
.env.*
!.env.example
!.env.*.example
*.local

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

compose.override.yml
compose.override.yaml
docker-compose.override.yml
docker-compose.override.yaml

.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/
